{
  "name": "titan-gym-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host 0.0.0.0",
    "typecheck": "tsc --noEmit",
    "build": "node scripts/build-static.mjs",
    "watch": "node scripts/build-static.mjs --watch",
    "check:static": "node --test scripts/static-site.test.mjs scripts/headline.test.mjs scripts/gallery.test.mjs scripts/inline-gallery.test.mjs"
  },
  "dependencies": {
    "react": "^19.2.3",
    "react-dom": "^19.2.3"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^5.1.2",
    "typescript": "^5.9.3",
    "vite": "^8.0.16"
  }
}
